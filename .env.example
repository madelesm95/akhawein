# ------------------------------------------------------------------
# Paymob — Dashboard → Settings → API Keys
# ------------------------------------------------------------------
# Secret key used only by the server to create payment intentions.
PAYMOB_SECRET_KEY=egy_sk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Public key used to build the Unified Checkout URL.
PAYMOB_PUBLIC_KEY=egy_pk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# One or more Integration IDs, comma separated (cards, wallets, kiosk…).
PAYMOB_INTEGRATION_IDS=123456,789012
# HMAC secret used to verify Paymob webhooks and redirects.
PAYMOB_HMAC_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: base URLs (leave empty for Egypt / production defaults).
# PAYMOB_API_BASE=https://accept.paymob.com
# PAYMOB_CHECKOUT_URL=https://eg.checkout.paymob.com/

# Legacy API key (only used by `node scripts/paymob-check.mjs`).
# PAYMOB_API_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------
# Google Sheets gateway — see google-apps-script/Code.gs
# ------------------------------------------------------------------
SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/xxxxxxxxxxxxxxxx/exec
SHEETS_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ------------------------------------------------------------------
# Site
# ------------------------------------------------------------------
SITE_URL=https://www.akhawein.org
DONATION_MIN_EGP=10
DONATION_MAX_EGP=200000

# Optional: protect /api/donations/health with ?token=...
# HEALTH_TOKEN=change-me
# Allow Vercel preview deployments to call the API (Origin check).
# ALLOW_VERCEL_PREVIEWS=true
