# Vercel Deployment Ignore List

# Local dev server only (must NOT be deployed — otherwise Vercel turns the
# whole site into a serverless function and static css/js return 404)
index.js
server.js
package.json
package.json.local
*.bak

*.psd
.git
.vscode/
.idea/
*.log
Thumbs.db
desktop.ini
.DS_Store

# Raw High-Res Media Folders (Handled via web-optimized images in images/gallery/)
الفيوم/
فلسطين/
اسماعلية/
قسم الصور/
موقع شهادات التقدير/
صور حفلة يوم اليتيم/
images/gallery/originals_backup/

# Video Files
*.mp4
*.mov
*.avi
*.mkv
*.webm

# Build sources and raw images: the site serves optimised copies from assets/
# (raw photos include unblurred originals that must not be public)
README.md
src/
images/
node_modules/
assets/css/site.css
assets/js/site.js
